# Copy to .env (never commit .env). Lines are KEY=value.
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_CHAT_DEPLOYMENT=chat
AZURE_EMBED_DEPLOYMENT=embed
# For local Ollama instead:
# LLM_PROVIDER=ollama
# OLLAMA_CHAT_MODEL=qwen2.5:7b
